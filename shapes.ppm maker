def rowmaker(row):
    lst = []
    dic = {}
    dic["r"] = 0
    dic["g"] = 0
    dic["b"] = 0
    for idx in range(row):
        lst.append(dic)
    return lst

def generateEmptyPicture(width,height):
    big_lst = []
    for idx in range(height):
        lst = rowmaker(width)
        big_lst.append(lst)
    return big_lst

