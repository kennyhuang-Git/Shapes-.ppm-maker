def clampValueToRange(value,low,high):
    if value<low:
        answer = int(low)
    if value>=low and value<=high:
        answer = int(value)
    if value>high:
        answer = int(high)
    return answer


def returnColor(line):
    lst = line.split(" ")
    lst2 = []
    start = 3
    for idx in range(len(lst)):
        x = int(lst[idx])
        lst2.append(x)
    for idx in range(start,len(lst)):
        lst2.pop()
    return lst2

def returnLocation(line):
    lst = line.split(" ")
    lst2 = []
    start = 3
    for idx in range(3,5):
        x = int(lst[idx])
        lst2.append(x)
    return lst2
