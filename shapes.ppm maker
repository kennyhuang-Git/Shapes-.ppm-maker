def addCircleToList(x,y,r,color,pixels):
    for yT in range(y-r,y+r+1):
        for xT in range(x-r,x+r+1):
            total = ((xT-x)*(xT-x)) + ((yT-y)*(yT-y))
            if total <= (r*r):
                pixels.append(append(color,xT,yT))


