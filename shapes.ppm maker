        if locationValid(x,width,y,height):
            image[y][x] = lst


def writePPM(image,filename):
    columns = len(image[0])
    rows = len(image)
    
    with open(filename,"a") as file:
        file.write("P3" + "\n")
        file.write(str(columns) + " " + str(rows) + "\n")
        file.write("255")
        file.write("\n")
        for idx in range(len(image)):
            lst = image[idx]
            for num in range(len(lst)):
                lsts = lst[num]
                file.write(str(lsts["r"]) + str(" ") + str(lsts["g"]) + " " + str(lsts["b"]) + "\n")


